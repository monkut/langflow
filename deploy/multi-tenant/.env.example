# Langflow Multi-Tenant Local Testing Configuration
# Copy this file to .env and configure your values
# Note: docker-compose.yml has default values; this file is for customization

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-secure-password
POSTGRES_DB=langflow

# Langflow Superuser Credentials
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=changeme-secure-password

# Database Connection
# Default: postgresql://postgres:password@postgres:5432/langflow
LANGFLOW_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Performance Settings
LANGFLOW_WORKERS=1
LANGFLOW_POOL_SIZE=20
LANGFLOW_MAX_OVERFLOW=30

# CORS Configuration (use * for local testing, specify origins for production)
LANGFLOW_CORS_ORIGINS=*
LANGFLOW_CORS_ALLOW_CREDENTIALS=true

# Logging
LANGFLOW_LOG_LEVEL=info

# Authentication
LANGFLOW_AUTO_LOGIN=false
